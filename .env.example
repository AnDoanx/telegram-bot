# Lấy token từ @BotFather trên Telegram
BOT_TOKEN=your_bot_token_here

# Telegram User ID của admin (dùng @userinfobot để lấy)
ADMIN_IDS=123456789,987654321

# Tên shop
SHOP_NAME=Shop Của Bạn

# Username admin để liên hệ (không có @)
ADMIN_USER_NAME=your_username

# SePay API Key (lấy từ my.sepay.vn)
SEPAY_API_KEY=your_sepay_api_key

# Thông tin ngân hàng
BANK_BIN=970423
BANK_ACCOUNT=123456789
BANK_NAME=TPBank
BANK_OWNER=NGUYEN VAN A

# --- Database ---
# auto = thử MySQL trước, lỗi kết nối thì dùng SQLite (file .db mở được bằng DB Browser)
# mysql | sqlite
DB_MODE=auto
# Đường dẫn file SQLite (mặc định: data/shop.db trong thư mục project)
# SQLITE_PATH=./data/shop.db

# MySQL (khi dùng MySQL hoặc DB_MODE=auto)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=telegram_shop
